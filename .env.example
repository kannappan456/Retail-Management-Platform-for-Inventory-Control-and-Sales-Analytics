# MLflow tracking is optional. If no URI is supplied, ShopSense stores runs
# under the local ./mlruns directory using MLflow's file store.
MLFLOW_TRACKING_ENABLED=true
# MLFLOW_TRACKING_URI=./mlruns

# File-based stores support tracking and artifacts but not the Model Registry.
# Use a database-backed store to enable model registration and versioning.
# Example for local development:
# MLFLOW_TRACKING_URI=sqlite:///./mlflow_tracking.db
# MLFLOW_REGISTRY_URI=sqlite:///./mlflow_tracking.db

# APScheduler jobs run in the API process; use one Uvicorn worker when enabled.
WORKFLOW_SCHEDULER_ENABLED=true
WORKFLOW_TIMEZONE=Asia/Kolkata
WORKFLOW_FORECAST_INTERVAL_HOURS=24
WORKFLOW_SEGMENTATION_INTERVAL_HOURS=168
WORKFLOW_RECOMMENDATION_INTERVAL_HOURS=24
WORKFLOW_RECOMMENDATION_K=5
